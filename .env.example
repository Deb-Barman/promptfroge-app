# The app itself needs no environment variables, keys or network.
# These are OPTIONAL and only used by release tooling (Fastlane / CI). Never commit real values.
# In CI, set them as GitHub Actions secrets instead (see docs/RELEASING.md).
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
PLAY_SERVICE_ACCOUNT_JSON=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_BASE64=
MATCH_GIT_URL=
MATCH_PASSWORD=
